#!/usr/bin/env python3
"""NexusOS — espace IA : IA locales, IA en ligne, assistant et agents.

Rangement (rien n'est mélangé) :
  ~/IA/Locales/<nom>/ia.json        une IA locale (modèle Ollama)
  ~/IA/En-ligne/<nom>/ia.json       une IA en ligne (fournisseur, adresse, modèle)
  ~/.config/nexusos/ia-cles.json    les clés API (droits 600, jamais dans ~/IA)
  ~/IA/Agents/<nom>/agent.json      un agent ; ses résultats dans ~/IA/Agents/<nom>/travail/
  ~/IA/Créations/                   ce que l'assistant crée (CV, maquettes…)
  ~/IA/Assistant/conversation.json  la conversation en cours

Toutes les commandes répondent par UNE ligne JSON.
  nexus-ia etat
  nexus-ia ajouter-locale NOM MODELE
  nexus-ia ajouter-en-ligne NOM FOURNISSEUR MODELE CLE [ADRESSE]
  nexus-ia supprimer locale|en-ligne NOM
  nexus-ia defaut locale|en-ligne NOM
  nexus-ia tester locale|en-ligne NOM
  nexus-ia demander MODE TEXTE          (MODE : discussion, cv, maquette)
  nexus-ia nouvelle-conversation
  nexus-ia ajouter-agent NOM ROLE TYPE_IA NOM_IA [CONSIGNES]
  nexus-ia agent-actif NOM on|off
  nexus-ia supprimer-agent NOM
  nexus-ia lancer-agent NOM TACHE
"""
import fcntl
import html
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

MAISON = Path.home()
RACINE = MAISON / "IA"
LOCALES = RACINE / "Locales"
EN_LIGNE = RACINE / "En-ligne"
AGENTS = RACINE / "Agents"
CREATIONS = RACINE / "Créations"
ASSISTANT = RACINE / "Assistant"
CONF = MAISON / ".config" / "nexusos"
CLES = CONF / "ia-cles.json"
REGLAGES = CONF / "ia.json"
OLLAMA = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")

# Fournisseurs en ligne connus : adresse de l'API et type de protocole
FOURNISSEURS = {
    "mistral":    {"nom": "Mistral",          "adresse": "https://api.mistral.ai/v1",                               "protocole": "openai"},
    "gemini":     {"nom": "Google Gemini",    "adresse": "https://generativelanguage.googleapis.com/v1beta/openai", "protocole": "openai"},
    "openai":     {"nom": "OpenAI",           "adresse": "https://api.openai.com/v1",                               "protocole": "openai"},
    "anthropic":  {"nom": "Anthropic Claude", "adresse": "https://api.anthropic.com/v1",                            "protocole": "anthropic"},
    "openrouter": {"nom": "OpenRouter",       "adresse": "https://openrouter.ai/api/v1",                            "protocole": "openai"},
    "groq":       {"nom": "Groq",             "adresse": "https://api.groq.com/openai/v1",                          "protocole": "openai"},
    "autre":      {"nom": "Autre (compatible OpenAI)", "adresse": "",                                               "protocole": "openai"},
}

# Rôles proposés pour les agents (repris des agents nexus-agents)
ROLES = {
    "debogueur":  "Tu es le débogueur de NexusOS (Arch Linux, Hyprland). Analyse l'erreur ou le journal fourni, "
                  "explique la cause en français simple et propose une correction précise.",
    "codeur":     "Tu es le codeur de NexusOS. Écris le script ou le fichier demandé, complet et commenté en français. "
