{
  "layer": "top",
  "position": "top",
  "height": 46,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "exclusive": true,
  "spacing": 0,

  "modules-left": ["custom/fermer", "custom/reduire", "custom/agrandir", "hyprland/workspaces"],
  "modules-center": ["network", "bluetooth", "pulseaudio", "battery"],
  "modules-right": ["clock"],

  // Boutons de la fenêtre active (comme sur la maquette)
  "custom/fermer": {
    "format": "●",
    "tooltip-format": "Fermer la fenêtre",
    "on-click": "hyprctl dispatch killactive"
  },
  "custom/reduire": {
    "format": "●",
    "tooltip-format": "Réduire (la fenêtre revient en cliquant sur son icône en bas)",
    "on-click": "hyprctl dispatch movetoworkspacesilent special:reduites"
  },
  "custom/agrandir": {
    "format": "●",
    "tooltip-format": "Agrandir / rétablir",
    "on-click": "hyprctl dispatch fullscreen 1"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "default": "○", "active": "●" },
    "persistent-workspaces": { "*": 4 }
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Connecté",
    "format-disconnected": "󰤭  Hors ligne",
    "tooltip-format": "{ifname} — {ipaddr}",
    "on-click": "kitty nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Bluetooth : {status}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "warning": 25, "critical": 12 }
  },

  "clock": {
    "locale": "fr_FR.UTF-8",
    "format": "{:L%a %d %b   %H:%M}",
    "tooltip-format": "<big>{:L%B %Y}</big>\n<tt>{calendar}</tt>"
  }
}
