/* NexusOS — menu de démarrage NexusOS (rofi) */
configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    fond:      rgba(6, 12, 34, 0.90);
    panneau:   rgba(14, 26, 66, 0.70);
    bordure:   rgba(79, 139, 255, 0.75);
    accent:    #2f6bff;
    texte:     #e6ecff;
    discret:   #9aa8d6;
    background-color: transparent;
    text-color: @texte;
    font: "Noto Sans 11";
}

window {
    width: 820px;
    border: 1px;
    border-color: @bordure;
    border-radius: 18px;
    background-color: @fond;
    padding: 22px;
}

mainbox { spacing: 18px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @panneau;
    border: 1px;
    border-color: rgba(79, 139, 255, 0.45);
    border-radius: 22px;
    padding: 12px 18px;
    children: [ prompt, entry ];
}
prompt { text-color: @discret; margin: 0 10px 0 0; }
entry  { placeholder: "Rechercher des applications…"; placeholder-color: @discret; }

listview {
    columns: 6;
    lines: 3;
    spacing: 10px;
    fixed-height: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 14px 6px;
    spacing: 8px;
    border-radius: 14px;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal {
    background-color: @accent;
    text-color: #ffffff;
}
element-icon { size: 48px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
