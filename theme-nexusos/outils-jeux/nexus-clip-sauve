#!/bin/sh
# NexusOS — appelé par gpu-screen-recorder après l'enregistrement d'un clip : $1 = fichier, $2 = type
[ "$2" = "replay" ] || exit 0
nom=$(basename "$1")
dossier=$(dirname "$1")
# En arrière-plan : l'enregistreur n'attend pas qu'on clique sur la notification
if command -v notify-send >/dev/null; then
    (
        reponse=$(notify-send -a "ActionReplay" -i media-record -A ouvrir="Ouvrir le dossier" \
            "Clip enregistré" "$nom" 2>/dev/null)
        [ "$reponse" = "ouvrir" ] && thunar "$dossier" >/dev/null 2>&1
    ) &
fi
exit 0
